# Docker Compose server port (also used inside the server container).
HOST=0.0.0.0
PORT=8080
NODE_ENV=production

# Docker service name; use 127.0.0.1 for running Node.js outside Docker.
POSTGRES_HOST=db
# Internal PostgreSQL port; it is isolated within Docker's network.
POSTGRES_PORT=5432
# Published host port; intentionally different from PostgreSQL's default.
POSTGRES_HOST_PORT=5435
POSTGRES_DB=url_shortener
POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=
